{
  "name": "Android-Codex-Dev",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },

    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },

    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },

    "ghcr.io/devcontainers/features/git:1": {}
  },


  "postCreateCommand": "bash .devcontainer/setup.sh && mkdir -p ~/.codex && cp .codex/config.toml ~/.codex/config.toml",


  "remoteUser": "vscode",


  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "GitHub.copilot",
        "ms-python.python",
        "redhat.java",
        "usernamehw.errorlens"
      ]
    }
  },


  "containerEnv": {
    "ANDROID_HOME": "/home/vscode/android-sdk",
    "ANDROID_SDK_ROOT": "/home/vscode/android-sdk"
  },


  "forwardPorts": [
    8000,
    8080
  ],


  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/android-sdk/platform-tools:/home/vscode/android-sdk/cmdline-tools/latest/bin"
  }
}
